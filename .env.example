# Sao chép file này thành .env rồi điền giá trị. File .env KHÔNG được commit (đã có trong .gitignore)
# và không bao giờ được máy chủ gửi xuống trình duyệt.

# ---- Dịch vụ AI (API dạng OpenAI Chat Completions) ----
# openai = gọi API thật | mock = chế độ demo, không gọi AI (chỉ để thử giao diện)
AI_PROVIDER=openai
AI_API_KEY=
# Tên model của nhà cung cấp, ví dụ: gpt-4o-mini
AI_MODEL=
# Mặc định là OpenAI. Một số endpoint tương thích khác:
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter    : https://openrouter.ai/api/v1
#   Groq          : https://api.groq.com/openai/v1
#   Ollama (máy cá nhân, không cần khoá): http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# Tuỳ chọn nâng cao
# AI_JSON_MODE=true              # gửi response_format=json_object; đặt false nếu nhà cung cấp không hỗ trợ
# AI_MAX_TOKENS=6000
# AI_MAX_TOKENS_FIELD=max_tokens # một số model mới yêu cầu max_completion_tokens; "none" = không gửi
# AI_TEMPERATURE=0.2             # bỏ trống = dùng mặc định của model
# AI_TIMEOUT_MS=60000
# AI_FALLBACK_MODELS=            # model dự phòng (phẩy ngăn cách) khi model chính quá tải/không còn hỗ trợ
#                                #   vd. Gemini: AI_MODEL=gemini-3.5-flash, AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# AI_REASONING_EFFORT=           # none|minimal|low|medium|high – model "thinking" (vd. Gemini) nên đặt low cho nhanh
# AI_RETRY_DELAY_MS=800          # thời gian chờ trước khi thử lại khi gặp lỗi 429/503
# Kiểm tra cấu hình bằng: npm run check-ai

# ---- Mật khẩu vào tab Writing (bỏ trống = không hỏi) ----
# Trên Cloudflare Worker đặt bằng: npx wrangler secret put WRITING_ACCESS_CODE (không ghi vào wrangler.toml).
# WRITING_ACCESS_CODE=

# ---- Giới hạn sử dụng (chống lạm dụng / tốn chi phí) ----
# WRITING_RATE_PER_MINUTE=5      # mỗi IP
# WRITING_RATE_PER_DAY=50        # mỗi IP
# WRITING_GLOBAL_DAILY_LIMIT=500 # toàn máy chủ
# WRITING_MAX_CONCURRENT=4

# ---- Máy chủ ----
# PORT=8080
# HOST=127.0.0.1                 # 0.0.0.0 để máy khác trong mạng truy cập
# TRUST_PROXY=false              # true chỉ khi chạy sau reverse proxy tin cậy (dùng X-Forwarded-For)
# ALLOWED_ORIGINS=               # domain khác được gọi API (CORS), vd. https://ten-ban.github.io
